---
import ThemeToggle from './ThemeToggle.astro';
---

<header class="border-b border-slate-800 bg-[#0D1322]/90 backdrop-blur-md sticky top-0 z-50">
  <div class="container mx-auto px-4 py-3.5 max-w-6xl flex justify-between items-center">
    
    <!-- Left: Logo -->
    <a href="/" class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-500 to-sky-400 flex items-center justify-center font-mono font-black text-white text-sm shadow-md shadow-indigo-500/20">
        ⚡
      </div>
      <div>
        <span class="font-extrabold text-base sm:text-lg tracking-tight text-white block leading-none">
          SOLOCARBON <span class="text-indigo-400 font-medium">TOOLS</span>
        </span>
        <span class="text-[10px] text-slate-400 font-semibold tracking-wider uppercase block mt-0.5">
          Client-Side DevOps Utilities
        </span>
      </div>
    </a>

    <!-- Right: Badge & Theme Toggle -->
    <div class="flex items-center gap-3">
      <span class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        100% Offline / Client-Side
      </span>
      <ThemeToggle />
    </div>

  </div>
</header>
